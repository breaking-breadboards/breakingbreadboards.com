<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&family=Fira+Sans:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
  <link rel="stylesheet" type="text/css" href="/style/terminal.css">
  <link rel="icon" href="/images/favicon.png" type="image/png">
  <meta name="description" content="{{ metadata.description }}">
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ page.url | absoluteUrl }}" />
  <meta property="og:image" content="{{ "/images/breaking-breadboards-logo-blue.png" | absoluteUrl }}" />
  <style>
  body {
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    padding: 0 1ch;
  }

  header, footer {
    text-align: center;
    margin: 25px 0;
  }

  #logo {
    width: 100%;
  }

  footer img {
    display: inline-block;
  }

  p img {
    margin: 0;
  }

  footer p {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  </style>
</head>

<body>
  <header>
  <a href="/" title="Breaking Breadboards"><img id="logo" src="/images/breaking-breadboards-logo-white.png" alt="Breaking Breadboards"></a>
  </header>
  {{ content }}
  <hr>
  <footer>
  Brought to you by&hellip;<br><br>
  <div><a href="https://www.linkedin.com/in/magarimike"><b>Mike Brewer</b></a></div>
  <div><a href="https://chetbox.com/"><b>Chetan Padia</b></a></div>
  <div><a href="https://youtube.com/@drjonea"><b>Jon Durrant</b></a></div>
  <div><a href="https://github.com/ndabas"><b>Nikhil Dabas</b></a></div>
  <br />
  and the incredible support of <a href="https://siliconbrighton.com">Silicon Brighton</a>
  <br /><br />
  <div>
  <a href="https://www.instagram.com/breakingbreadboards/" title="Instagram"><img height="24" src="/images/instagram-white.svg" alt="Instagram"></a>
  &nbsp;
  <a href="https://www.youtube.com/@breakingbreadboards" title="YouTube"><img height="24" src="/images/youtube-white.svg" alt="YouTube"></a>
  &nbsp;
  <a href="https://www.linkedin.com/company/breaking-breadboards/" title="LinkedIn"><img height="24" src="/images/linkedin-white.svg" alt="LinkedIn"></a>
  &nbsp;
  <a href="https://github.com/breaking-breadboards" title="GitHub"><img height="24" src="/images/github-white.svg" alt="GitHub"></a>
  &nbsp;
  <a href="https://join.slack.com/t/silicon-brighton/shared_invite/zt-2rfg1b62d-JeOYQX5UYtgUcQkAvHGefQ" title="Slack"><img height="24" src="/images/slack-white.svg" alt="Slack"></a>
  </div>
  <p>
  <img height="50" src="/images/breaking-breadboards-bot-white.png" alt="Breaking Breadboards">
  <a href="https://siliconbrighton.com/" title="Silicon Brighton"><img height="50" src="/images/silicon-brighton-logo.png" alt="Silicon Brighton"></a>
  </p>
  </footer>
</body>

</html>
