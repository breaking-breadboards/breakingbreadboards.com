<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&family=Fira+Sans:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
  <link rel="stylesheet" type="text/css" href="/style/terminal.css">
  <link rel="icon" href="/images/favicon.png" type="image/png">
  <meta name="description" content="{{ metadata.description }}">
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ page.url | absoluteUrl }}" />
  <meta property="og:image" content="{{ "/images/breaking-breadboards-logo-blue.png" | absoluteUrl }}" />
  <style>
  body {
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    padding: 0 1ch;
  }

  #logo {
    width: 100%;
  }
  </style>
</head>

<body>
  <a href="/"><img id="logo" src="/images/breaking-breadboards-logo-white.png" alt="Breaking Breadboards"></a>
  {{ content }}
  <hr>
  <footer>
  <p>
    Brought to you by...

  <div><b>Mike Brewer</b></div>
  <div><b>Chetan Padia</b></div>
  <div><b>Jon Durrant</b></div>
  <div><b>Nikhil Dabas</b></div>

  <br />
  and the incredible support of <a href="https://siliconbrighton.com">Silicon Brighton</a>
  <br />
  <br />
  <a href="https://siliconbrighton.com/"><img height="50" src="/images/silicon-brighton-logo.png"
      alt="Silicon Brighton" /></a>
  </p>
  </footer>
</body>

</html>
